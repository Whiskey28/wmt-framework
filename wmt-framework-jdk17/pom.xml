<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <artifactId>wmt-jdk17</artifactId>
        <groupId>com.wmt</groupId>
        <version>${revision}</version>
    </parent>
    <packaging>pom</packaging>
    <modules>
        <module>wmt-common</module>
        <module>wmt-spring-boot-starter-mybatis</module>
        <module>wmt-spring-boot-starter-redis</module>
        <module>wmt-spring-boot-starter-web</module>
        <module>wmt-spring-boot-starter-security</module>
        <module>wmt-spring-boot-starter-websocket</module>

        <module>wmt-spring-boot-starter-monitor</module>
        <module>wmt-spring-boot-starter-protection</module>
        <module>wmt-spring-boot-starter-job</module>
        <module>wmt-spring-boot-starter-mq</module>

        <module>wmt-spring-boot-starter-excel</module>
        <module>wmt-spring-boot-starter-test</module>

        <module>wmt-spring-boot-starter-biz-tenant</module>
        <module>wmt-spring-boot-starter-biz-data-permission</module>
        <module>wmt-spring-boot-starter-biz-ip</module>
        <module>wmt-spring-boot-starter-biz-finance</module>

        <module>wmt-spring-boot-starter-sjb</module>
        <module>wmt-spring-boot-starter-esb</module>
        <module>wmt-spring-boot-starter-crypto-platform</module>
        <!-- partner-http 源码保留，待组件库下一版发布后再启用 module -->
        <!-- <module>wmt-spring-boot-starter-partner-http</module> -->
        <module>wmt-spring-boot-starter-xxljob</module>
    </modules>

    <artifactId>wmt-framework-jdk17</artifactId>
    <description>
        该包是技术组件，每个子包，代表一个组件。每个组件包括两部分：
            1. core 包：是该组件的核心封装
            2. config 包：是该组件基于 Spring 的配置

        技术组件，也分成两类：
            1. 框架组件：和我们熟悉的 MyBatis、Redis 等等的拓展
            2. 业务组件：和业务相关的组件的封装，例如说数据字典、操作日志等等。
        如果是业务组件，Maven 名字会包含 biz
    </description>

    <properties>
        <!-- parent.parent = wmt-jdk17 仓库根；避免子模块二次插值 project.basedir 指到模块目录 -->
        <proguard.config>${project.parent.parent.basedir}/docs/proguard/${proguard.starter.config.file}</proguard.config>
    </properties>

    <profiles>
        <!-- 仅对含 src/main/java 的 jar 子模块挂载 ProGuard（本 aggregator 不会激活） -->
        <profile>
            <id>proguard-jar-modules</id>
            <activation>
                <file>
                    <exists>${basedir}/src/main/java</exists>
                </file>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.github.wvengen</groupId>
                        <artifactId>proguard-maven-plugin</artifactId>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
