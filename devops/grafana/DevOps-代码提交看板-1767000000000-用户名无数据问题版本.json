      "targets": [
        {
          "dataset": "yanlian_devops_scm",
          "datasource": {
            "type": "mysql",
            "uid": "af7fx0o982qrkf"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT \n  o.name AS org_name,\n  COALESCE(u.name, c.committer_name) AS user_name,\n  COALESCE(u.username, c.committer_name) AS username,\n  COUNT(*) AS commit_count,\n  IFNULL(SUM(c.additions), 0) AS total_additions,\n  IFNULL(SUM(c.deletions), 0) AS total_deletions,\n  IFNULL(SUM(c.total), 0) AS total_changes,\n  ROUND(IFNULL(SUM(c.total), 0) / NULLIF(COUNT(*), 0), 2) AS avg_changes_per_commit,\n  MIN(c.create_time) AS first_commit_time,\n  MAX(c.create_time) AS last_commit_time\nFROM yanlian_devops_scm.commit_info c\nJOIN yanlian_devops_scm.tenant_project_relation tpr\n  ON tpr.project_id = c.gitlab_id\n AND (tpr.server_id IS NULL OR tpr.server_id = c.server_id)\nJOIN yanlian_app_management.sys_organization o\n  ON o.id = tpr.tenant_id\nLEFT JOIN yanlian_devops_scm.amp_gitlab_user_relation agur\n  ON c.gitlab_user_id = agur.gitlab_user_id\n AND c.server_id = agur.server_id\nLEFT JOIN yanlian_app_management.sys_user u\n  ON agur.amp_user_id = u.id\nWHERE c.create_time IS NOT NULL\n  AND YEAR(c.create_time) IN (${year:csv})\n  AND DATE_FORMAT(c.create_time, '%m') IN (${months:csv})\n  AND o.is_deleted = 0\n  AND (${tenantId:csv} = '0' OR FIND_IN_SET(o.id, '${tenantId:csv}') > 0)\nGROUP BY o.id, o.name, u.id, u.name, u.username, c.committer_name\nORDER BY total_changes DESC;",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [],
            "limit": 5000
          }
