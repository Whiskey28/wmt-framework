          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT \n  o.name AS org_name,\n  COUNT(*) AS commit_count\nFROM yanlian_devops_scm.commit_info c\nJOIN yanlian_devops_scm.tenant_project_relation tpr\n  ON tpr.project_id = c.gitlab_id\n AND (tpr.server_id IS NULL OR tpr.server_id = c.server_id)\nJOIN yanlian_app_management.sys_organization o\n  ON o.id = tpr.tenant_id\nWHERE c.create_time IS NOT NULL\n  AND YEAR(c.create_time) IN (${year:csv})\n  AND DATE_FORMAT(c.create_time, '%m') IN (${months:csv})\n  AND o.is_deleted = 0\n  AND (${tenantId:csv} = '0' OR FIND_IN_SET(o.id, '${tenantId:csv}') > 0)\nGROUP BY o.id, o.name\nORDER BY commit_count DESC\nLIMIT 10;",
