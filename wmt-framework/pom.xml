<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <artifactId>wmt</artifactId>
        <groupId>com.wmt</groupId>
        <version>${revision}</version>
    </parent>
    <packaging>pom</packaging>
    <modules>
        <module>wmt-common</module>
        <module>wmt-spring-boot-starter-mybatis</module>
        <module>wmt-spring-boot-starter-cache</module>
        <!--兼容旧版本redis-->
        <module>wmt-spring-boot-starter-redis</module>
        <module>wmt-spring-boot-starter-web</module>
        <module>wmt-spring-boot-starter-security</module>
        <module>wmt-spring-boot-starter-websocket</module>

        <module>wmt-spring-boot-starter-monitor</module>
        <module>wmt-spring-boot-starter-prometheus-grafana</module>
        <module>wmt-spring-boot-starter-protection</module>
        <module>wmt-spring-boot-starter-job</module>
        <module>wmt-spring-boot-starter-xxljob</module>
        <module>wmt-spring-boot-starter-mq</module>

        <module>wmt-spring-boot-starter-excel</module>
        <module>wmt-spring-boot-starter-test</module>

        <module>wmt-spring-boot-starter-biz-tenant</module>
        <module>wmt-spring-boot-starter-biz-data-permission</module>
        <module>wmt-spring-boot-starter-biz-ip</module>

        <module>wmt-spring-boot-starter-elk-logging</module>
        <module>wmt-spring-boot-starter-sjb</module>

<!--        <module>wmt-spring-boot-starter-file</module>-->
<!--        <module>wmt-spring-boot-starter-storage</module>-->
<!--        <module>wmt-spring-boot-starter-search</module>-->
<!--        <module>wmt-spring-boot-starter-log</module>-->
    </modules>

    <artifactId>wmt-framework</artifactId>
    <description>
        该包是技术组件，每个子包，代表一个组件。每个组件包括两部分：
            1. core 包：是该组件的核心封装
            2. config 包：是该组件基于 Spring 的配置

        技术组件，也分成两类：
            1. 框架组件：和我们熟悉的 MyBatis、Redis 等等的拓展
            2. 业务组件：和业务相关的组件的封装，例如说数据字典、操作日志等等。
        如果是业务组件，Maven 名字会包含 biz
    </description>
    <url>https://github.com/Wmt/wmt-framework</url>

    <build>
        <plugins>
            <!-- 禁用源码jar生成，保护源代码 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <phase>none</phase>
                    </execution>
                </executions>
            </plugin>

            <!-- 禁用javadoc生成，避免路径解析错误 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.10.1</version>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <phase>none</phase>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
