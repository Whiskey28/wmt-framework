{
  "title": "WMT 应用概览",
  "panels": [
    {
      "title": "HTTP 请求耗时 P95",
      "type": "graph",
      "datasource": "$datasource",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{job=\"$job\",status!~\"5..\"}[5m])) by (le))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "title": "HTTP 5xx 比例",
      "type": "stat",
      "datasource": "$datasource",
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"$job\",status=~\"5..\"}[5m])) / sum(rate(http_server_requests_seconds_count{job=\"$job\"}[5m]))",
          "legendFormat": "error"
        }
      ]
    },
    {
      "title": "JVM 堆使用率",
      "type": "gauge",
      "datasource": "$datasource",
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{area=\"heap\",job=\"$job\"}) / sum(jvm_memory_max_bytes{area=\"heap\",job=\"$job\"})",
          "legendFormat": "heap"
        }
      ]
    },
    {
      "title": "线程活跃数",
      "type": "graph",
      "datasource": "$datasource",
      "targets": [
        {
          "expr": "jvm_threads_live_threads{job=\"$job\"}",
          "legendFormat": "live"
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "datasource",
        "query": "prometheus"
      },
      {
        "type": "query",
        "name": "job",
        "datasource": "$datasource",
        "query": "label_values(up, job)"
      }
    ]
  },
  "schemaVersion": 39,
  "version": 1,
  "style": "dark",
  "tags": [
    "wmt",
    "prometheus"
  ],
  "editable": true,
  "graphTooltip": 0
}

