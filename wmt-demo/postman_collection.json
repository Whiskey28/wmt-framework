{
  "info": {
    "name": "WMT Demo API",
    "description": "WMT组件库演示项目API测试集合",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "用户管理",
      "item": [
        {
          "name": "获取用户列表",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/user/list",
              "host": ["{{baseUrl}}"],
              "path": ["api", "user", "list"]
            }
          }
        },
        {
          "name": "根据ID获取用户",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/user/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "user", "1"]
            }
          }
        },
        {
          "name": "根据用户名获取用户",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/user/username/admin",
              "host": ["{{baseUrl}}"],
              "path": ["api", "user", "username", "admin"]
            }
          }
        },
        {
          "name": "创建用户",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser\",\n  \"password\": \"123456\",\n  \"nickname\": \"测试用户\",\n  \"email\": \"test@example.com\",\n  \"mobile\": \"13800138888\",\n  \"status\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/user",
              "host": ["{{baseUrl}}"],
              "path": ["api", "user"]
            }
          }
        },
        {
          "name": "更新用户",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 1,\n  \"nickname\": \"超级管理员\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/user",
              "host": ["{{baseUrl}}"],
              "path": ["api", "user"]
            }
          }
        },
        {
          "name": "删除用户",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/user/4",
              "host": ["{{baseUrl}}"],
              "path": ["api", "user", "4"]
            }
          }
        }
      ]
    },
    {
      "name": "Redis测试",
      "item": [
        {
          "name": "测试Redis存取",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/user/redis/test?key=testkey&value=testvalue",
              "host": ["{{baseUrl}}"],
              "path": ["api", "user", "redis", "test"],
              "query": [
                {
                  "key": "key",
                  "value": "testkey"
                },
                {
                  "key": "value",
                  "value": "testvalue"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Excel测试",
      "item": [
        {
          "name": "导出用户Excel",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/user/export",
              "host": ["{{baseUrl}}"],
              "path": ["api", "user", "export"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/demo",
      "type": "string"
    }
  ]
}

